<style>

:root{
  --primary:#0d6efd;
  --primary-light:#eef6ff;
  --success:#198754;
  --success-light:#edf9f1;
  --warning:#ffc107;
  --danger:#dc3545;
  --card-radius:18px;
}

/* ---------- Dashboard ---------- */

.dashboard-card{
    max-width:430px;
    margin:auto;
    background:#fff;
    border-radius:22px;
    padding:18px;
    box-shadow:0 10px 35px rgba(0,0,0,.08);
}

/* ---------- Generic Cards ---------- */

.dashboard-section{
    background:#fff;
    border-radius:18px;
    padding:16px;
    margin-bottom:14px;
    border:1px solid #edf1f5;
    box-shadow:0 4px 14px rgba(0,0,0,.05);
}

/* ---------- Profile Card ---------- */

.profile-card{
    background:linear-gradient(135deg,#f9fffc,#eef7ff);
    border:1px solid #d9ecff;
}

.profile-photo{
    width:72px;
    height:92.57px;
    object-fit:cover;
    border:3px solid #fff;
    box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.profile-placeholder{
    width:72px;
    height:92.57px;
    background:#f3f4f6;
    border:2px solid #ddd;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
}

/* ---------- Status Badge ---------- */

.status-pill{
    display:inline-block;
    padding:5px 12px;
    border-radius:40px;
    font-size:.78rem;
    font-weight:600;
}

.status-approved{
    background:#d1f5df;
    color:#0f6d38;
}

.status-pending{
    background:#fff4cf;
    color:#8a6800;
}

.status-none{
    background:#ececec;
    color:#666;
}

/* ---------- Buttons Grid ---------- */

.btn-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.btn-grid .btn{
    height:54px;
    border-radius:14px;
    font-weight:600;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.95rem;
    box-shadow:0 3px 8px rgba(0,0,0,.08);
}

/* ---------- Large Buttons ---------- */

.btn-large{
    height:52px;
    border-radius:14px;
    font-weight:600;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* ---------- Calendar Badge ---------- */

.badge-calendar{
    position:absolute;
    top:6px;
    right:10px;
    width:22px;
    height:22px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.72rem;
    background:#dc3545;
    color:#fff;
}

/* ---------- Progress ---------- */

.progress{
    height:12px;
    border-radius:10px;
    background:#e9ecef;
}

.progress-bar{
    transition:width .5s;
}

/* ---------- Steps Box ---------- */

.steps-box{
    background: linear-gradient(135deg,#1e3c72,#2a5298);
    border-radius:18px;
    padding:16px 20px !important;
    color:#fff;
    font-weight:600;
    box-shadow:0 8px 18px rgba(30,60,114,.28);
    position:relative;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.12);
}

/* Soft light overlay */
.steps-box::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        to bottom,
        rgba(255,255,255,.18),
        rgba(255,255,255,.02)
    );
}

/* Soft highlight */
.steps-box::after{
    content:"";
    position:absolute;
    top:-60%;
    right:-20%;
    width:140px;
    height:140px;
    background:rgba(255,255,255,.12);
    border-radius:50%;
    filter:blur(25px);
}
/* ---------- Notification ---------- */

#notificationBar{
    max-width:430px;
    margin:12px auto;
    background:linear-gradient(135deg,#1e88e5,#42a5f5);
    color:#fff;
    border-radius:14px;
    overflow:hidden;
    padding:8px 14px;
    font-weight:600;
    white-space:nowrap;
}

#notificationText{
    display:inline-block;
    padding-left:100%;
    animation:scroll 25s linear infinite;
}

/* ---------- Tip Card ---------- */

#tipImageArea{
    padding:8px;
    border-radius:18px;
    background:linear-gradient(180deg,#c1ebb4,#fff);
    box-shadow:0 10px 30px rgba(0,0,0,.12);
    max-width:380px;
    margin:auto;
}

/* ---------- Kender ---------- */

.kender-tip-box{
    background:#f8fff8;
    border:1px solid #28a745;
    border-left:4px solid #28a745;
    border-radius:10px;
    margin-top:10px;
    padding:8px;
}

.kender-tip-box p{
    margin:0;
    font-size:.9rem;
}

/* ---------- Download ---------- */

#downloadTipBtn{
    background:#198754;
    color:#fff;
    font-weight:600;
}

/* ---------- Animation ---------- */

@keyframes scroll{
    from{
        transform:translateX(0);
    }
    to{
        transform:translateX(-100%);
    }
}

/* ---------- Mobile ---------- */

@media(max-width:480px){

    .dashboard-card{
        padding:14px;
        border-radius:18px;
    }

    .btn-grid .btn{
        height:50px;
        font-size:.88rem;
    }

    .profile-photo,
    .profile-placeholder{
        width:64px;
        height:64px;
    }

}

</style>

