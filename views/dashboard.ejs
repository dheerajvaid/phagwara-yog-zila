document
.getElementById("removePhotoBtn")
.addEventListener("click", async function () {

    const result = await Swal.fire({
        title: "Remove Photo?",
        text: "This will permanently delete your profile photo.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Remove",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#dc3545"
    });

    if (!result.isConfirmed) return;

    try {

        const saadhakId = "<%= user.id %>";

        const res = await fetch(`/saadhak/remove-photo/${saadhakId}`, {
            method: "POST"
        });

        const data = await res.json();

        if (data.success) {

            await Swal.fire({
                icon: "success",
                title: "Photo Removed",
                text: "Your profile photo has been removed.",
                timer: 1500,
                showConfirmButton: false
            });

            window.location.reload();

        } else {

            Swal.fire(
                "Error",
                data.message || "Unable to remove photo.",
                "error"
            );

        }

    } catch (err) {

        Swal.fire(
            "Error",
            "Server Error",
            "error"
        );

    }

});

});
